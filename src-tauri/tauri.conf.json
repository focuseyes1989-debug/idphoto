{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ID Photo Studio",
  "version": "0.1.4",
  "identifier": "com.idphotostudio.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "ID Photo Studio",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBQkM5NzI1MEFFNTNDQUEKUldTcVBPVUtKWmU4ZWdIT0J5dkxSQy9jZ2NvNGxhbzJFSVllcHB2Q2VyVDY3TEpnM25rcVJtODYK",
      "endpoints": [
        "https://github.com/focuseyes1989-debug/idphoto/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
